<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and 11: nothing to install on the target PC. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TenveoPtz.App</RootNamespace>
    <AssemblyName>TenveoPTZ</AssemblyName>
    <AssemblyTitle>Tenveo PTZ Controller</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Released as a single file: no TenveoPTZ.exe.config (it only repeated the target framework). -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!--
    The core library is compiled into the executable rather than referenced, so the released
    TenveoPTZ.exe is a single file with nothing to keep next to it. Tests use the library project.
  -->
  <ItemGroup>
    <Compile Include="..\TenveoPtz.Core\**\*.cs" Exclude="..\TenveoPtz.Core\bin\**;..\TenveoPtz.Core\obj\**" LinkBase="Core" />
  </ItemGroup>

</Project>
